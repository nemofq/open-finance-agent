{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Required when creating a report."
    },
    "template": {
      "description": "Optional; omit for free-form analysis. Required sections by template: earnings-preview: Setup / Expectations / What matters this quarter / Scenarios / Risks / Stance; earnings-review: Results vs expectations / Guidance / Drivers / Reaction / Stance; stock-brief: Business / Key metrics / Valuation / Recent developments / Risks; valuation: Approach / Inputs / Valuation / Sensitivity / Stance; peer-comps: Peer set / Comparison / Read-through; filing-changes: Filing / What changed / Why it matters; portfolio-check: Holdings / Concentration / Fit with profile; thesis-check: Thesis / Evidence since / Verdict.",
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "doc",
        "slides"
      ]
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "evidence_table"
                    },
                    "source": {
                      "type": "string",
                      "description": "Evidence id such as E7 or C3. Copies the source table with exact periods, units and citations."
                    },
                    "metrics": {
                      "description": "For structured facts, select metric names from the evidence. Omit to show all metrics, or a calculator table.",
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "type",
                    "source"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "description": "Prose with quantitative claims as {C3} or {E7:metric:period} references."
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "kpis"
                    },
                    "items": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "cell": {
                            "type": "object",
                            "properties": {
                              "ref": {
                                "description": "Preferred: E7:revenue:2024-06-30, C3 for a scalar, or C3:label for a calculated series item. The renderer retrieves the value, unit and source; omit value and src.",
                                "type": "string"
                              },
                              "value": {
                                "default": "",
                                "description": "A literal value with src, or non-numeric text such as not guided. Prefer ref for figures.",
                                "type": [
                                  "number",
                                  "string"
                                ]
                              },
                              "unit": {
                                "type": "string"
                              },
                              "src": {
                                "default": "",
                                "type": "string"
                              },
                              "metric": {
                                "description": "Metric in the cited source; use with period to identify the exact fact.",
                                "type": "string"
                              },
                              "period": {
                                "type": "string"
                              },
                              "note": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "required": [
                          "label",
                          "cell"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "items"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "table"
                    },
                    "columns": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "ref": {
                                  "description": "Preferred: E7:revenue:2024-06-30, C3 for a scalar, or C3:label for a calculated series item. The renderer retrieves the value, unit and source; omit value and src.",
                                  "type": "string"
                                },
                                "value": {
                                  "default": "",
                                  "description": "A literal value with src, or non-numeric text such as not guided. Prefer ref for figures.",
                                  "type": [
                                    "number",
                                    "string"
                                  ]
                                },
                                "unit": {
                                  "type": "string"
                                },
                                "src": {
                                  "default": "",
                                  "type": "string"
                                },
                                "metric": {
                                  "description": "Metric in the cited source; use with period to identify the exact fact.",
                                  "type": "string"
                                },
                                "period": {
                                  "type": "string"
                                },
                                "note": {
                                  "type": "string"
                                }
                              }
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      }
                    },
                    "key": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "type",
                    "columns",
                    "rows"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "chart"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "line",
                        "bar"
                      ]
                    },
                    "series": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "points": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "x": {
                                  "type": "string"
                                },
                                "y": {
                                  "type": "object",
                                  "properties": {
                                    "ref": {
                                      "description": "Preferred: E7:revenue:2024-06-30, C3 for a scalar, or C3:label for a calculated series item. The renderer retrieves the value, unit and source; omit value and src.",
                                      "type": "string"
                                    },
                                    "value": {
                                      "default": "",
                                      "description": "A literal value with src, or non-numeric text such as not guided. Prefer ref for figures.",
                                      "type": [
                                        "number",
                                        "string"
                                      ]
                                    },
                                    "unit": {
                                      "type": "string"
                                    },
                                    "src": {
                                      "default": "",
                                      "type": "string"
                                    },
                                    "metric": {
                                      "description": "Metric in the cited source; use with period to identify the exact fact.",
                                      "type": "string"
                                    },
                                    "period": {
                                      "type": "string"
                                    },
                                    "note": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              "required": [
                                "x",
                                "y"
                              ]
                            }
                          }
                        },
                        "required": [
                          "name",
                          "points"
                        ]
                      }
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "kind",
                    "series"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "callout"
                    },
                    "tone": {
                      "type": "string",
                      "enum": [
                        "neutral",
                        "positive",
                        "negative"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "tone",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "list"
                    },
                    "items": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "type",
                    "items"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "html"
                    },
                    "html": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "html"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "heading",
          "blocks"
        ]
      }
    }
  },
  "required": [
    "title",
    "sections"
  ],
  "~standard": {
    "vendor": "zod",
    "version": 1,
    "jsonSchema": {}
  }
}
