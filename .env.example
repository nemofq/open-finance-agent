# docs/usage.md › Environment variables and CONTRIBUTING.md › Checks describe these variables.

# The data folder; defaults to ~/.open-finance-agent when unset.
OFA_HOME=

# Comma-separated hostnames allowed to reach `next dev` from another machine; the API also accepts their writes.
# Example: OFA_DEV_ORIGINS=devcontainer,devcontainer.example.ts.net
OFA_DEV_ORIGINS=

# Development switch: 1 runs every policy rule in observe mode, recorded but never enforced.
OFA_POLICY_OBSERVE=

# Test only: 1 runs the calculator sandbox conformance suite, which takes minutes.
OFA_SANDBOX_TESTS=

# Test only: 1 runs the live tests against real providers and MCP servers.
OFA_LIVE_TESTS=

# Test only: an OpenRouter key for the live agent test.
OPENROUTER_API_KEY_TEST=

# Test only: an OpenAI-compatible base URL, including /v1, for the live tests.
CUSTOM_LLM_URL=

# Test only: the key for CUSTOM_LLM_URL, if it needs one.
CUSTOM_LLM_API_KEY=

# Test only: comma-separated model ids served at CUSTOM_LLM_URL; the first must be tool-capable.
CUSTOM_LLM_AVAILABLE=

# Base URL of a Pyodide `full/` mirror for the calculator's Python packages; defaults to jsDelivr.
OFA_PYODIDE_CDN=

# The attachment parse worker's path, for a deployment that moves the sources out of src/.
OFA_PARSE_WORKER=

# Test only: a Chromium binary for `pnpm test:browser` instead of Playwright's download.
OFA_BROWSER_EXECUTABLE=
